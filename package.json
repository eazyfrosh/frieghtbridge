{
  "name": "freightbridge",
  "version": "1.0.0",
  "private": true,
  "description": "FreightBridge — modern freight & logistics website",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "hash-password": "node scripts/hash-password.mjs",
    "seed": "node scripts/seed-firestore.mjs",
    "seed:emulator": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node scripts/seed-firestore.mjs",
    "emulators": "firebase emulators:start --project demo-freightbridge",
    "doctor": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "next": "^15.1.4",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "//overrides": "firebase-admin depends on jwks-rsa, which loads jose with require(). jose 6 is ESM-only, so that only works where require(esm) is enabled — Vercel's runtime has it off, and firebase-admin fails to import there with ERR_REQUIRE_ESM before any credential is read. jose 5 ships a CommonJS build and still exports the four functions jwks-rsa uses: decodeJwt, decodeProtectedHeader, exportSPKI, importJWK. Drop this once jwks-rsa switches to await import().",
  "overrides": {
    "jose": "^5.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.4",
    "firebase-tools": "^15.26.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
