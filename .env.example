# Admin sign-in. Copy to .env.local for development, and set the same three
# variables in your hosting provider's environment for production.
#
# .env.local is gitignored. Never commit real values.

# Signs the session cookie. 32+ characters.
#   openssl rand -base64 32
AUTH_SECRET=

# The operator login.
ADMIN_EMAIL=ops@freightbridge.com

# scrypt hash of the password — NOT the password itself.
# Generate with:  npm run hash-password
ADMIN_PASSWORD_HASH=
