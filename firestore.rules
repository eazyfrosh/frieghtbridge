rules_version = '2';

// Deny-all, which is also Firebase's production-mode default. It is kept in
// the repo so the policy is version-controlled and reviewable, not because it
// differs from what the console starts you with.
//
// It is the correct rule for this app rather than a placeholder: every read
// goes through the Admin SDK on the server, which bypasses rules entirely.
// Nothing in the browser holds a Firestore handle, so there is no client
// access to grant. The only route to shipment data from outside is
// GET /api/tracking, which answers one exact tracking number.
//
// The `shipments` block below is spelled out separately even though the
// catch-all already covers it. It is there so that the next person to add a
// client-side read — a customer portal, live status — finds a documented
// decision rather than an unexamined default, and writes a narrow rule for
// their collection instead of loosening this one.
service cloud.firestore {
  match /databases/{database}/documents {

    // Server-only, via the Admin SDK. See lib/shipments.ts.
    match /shipments/{trackingNumber} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
