rules_version = '2';

// Everything is denied to clients, on purpose.
//
// The app reaches Firestore only through the Admin SDK on the server, which
// bypasses these rules entirely. Nothing in the browser ever holds a Firestore
// handle, so a blanket deny costs the app nothing and means a leaked client
// config grants no read access to shipment data.
//
// If a client-side read is ever genuinely needed, add a narrow rule for that
// one collection rather than loosening this default.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
