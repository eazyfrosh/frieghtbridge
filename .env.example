# ---------------------------------------------------------------------------
# Firebase
# ---------------------------------------------------------------------------
# Copy to .env.local for development. .env.local is gitignored — never commit
# real values. Set the same variables in your host's dashboard for production.

# Client SDK config. These are public by design: a Firebase API key identifies
# a project, it does not authorise anything. Access is decided by Firebase Auth
# and by firestore.rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional — only needed if Cloud Storage or Messaging are added later.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Service account JSON for the Admin SDK. THIS IS A REAL SECRET — it bypasses
# every Firestore rule. Server-only; never prefix it with NEXT_PUBLIC_.
# Paste the whole JSON on one line, or base64-encode it if your host mangles
# multi-line values (both are accepted).
FIREBASE_SERVICE_ACCOUNT_KEY=

# Who may enter /admin. Comma-separated, case-insensitive.
# REQUIRED — an empty list authorises nobody. Having a Firebase account is not
# the same as being an operator: Firebase allows public self-signup by default
# and the API key ships in the client bundle, so without this list anyone could
# enrol themselves into the admin area.
ADMIN_EMAILS=ops@freightbridge.com

# ---------------------------------------------------------------------------
# Email notifications
# ---------------------------------------------------------------------------
# Without these, /admin/templates still lets you edit and preview the wording —
# only sending is switched off, and the admin UI says so rather than failing
# silently when someone presses Send.

# Resend API key: https://resend.com → API Keys. Free tier covers 3,000/month.
RESEND_API_KEY=

# The From address. The domain must be verified in Resend, or it will refuse
# the send. Both "ops@yourdomain.com" and "FreightBridge <ops@yourdomain.com>"
# are accepted; the second is what customers see in their inbox.
EMAIL_FROM=

# Optional. Where customer replies go, if that is not the From address.
EMAIL_REPLY_TO=

# Optional. Overrides the provider endpoint — used by the test suite to point
# at a stub, and by deployments that must send through an egress gateway.
# RESEND_API_URL=https://api.resend.com/emails

# Used to build the tracking links inside emails. Without it they fall back to
# SITE.url in lib/site.ts, which is a placeholder domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---------------------------------------------------------------------------
# Emulators (local development only — leave unset in production)
# ---------------------------------------------------------------------------
# npm run emulators      then, in another shell:  npm run seed:emulator
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=http://127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
